# Copy these settings to the frontend root .env.collaboration.local.
# Private server configuration: NEVER use a VITE_ prefix for the bridge key.
APP_FILES_COLLABORATION_KEY=replace-with-the-same-random-48-byte-key-as-the-backend
EAC_BACKEND_URL=http://127.0.0.1:8080
EAC_COLLABORATION_HOST=127.0.0.1
EAC_COLLABORATION_PORT=1234
EAC_COLLABORATION_ROOT=./.collaboration-data
EAC_COLLABORATION_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
